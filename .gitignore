# Generated at runtime — ephemeral on Streamlit Cloud, don't commit run artifacts
outputs/decision_logs/*.json
outputs/decision_logs/*.md
outputs/geojson/*.geojson
outputs/monitoring/*.json
outputs/reviews/*.jsonl
outputs/on_demand/*.json
outputs/on_demand/previews/
outputs/member_a_handoff_same_season.json
outputs/realtime_cache/
.streamlit/secrets.toml
!outputs/decision_logs/.gitkeep
!outputs/geojson/.gitkeep
!outputs/monitoring/.gitkeep
!outputs/reviews/.gitkeep
!outputs/on_demand/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/

# Secrets — Earth Engine service account key, Gemini API key, etc.
# NEVER commit these; Streamlit Cloud secrets go in its own secrets manager instead
*.json.key
.env
config/credentials*
service_account*.json
config/user_region.geojson

# Notebook checkpoints
.ipynb_checkpoints/

# OS
.DS_Store
